PORT=3000
LLM_PROVIDER=anthropic
# Native Messages API base URL; do not append /messages.
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL=claude-sonnet-5-5
# Put the real key in .env; never commit it here.
LLM_API_KEY=
# Optional for API keys that are not scoped to a workspace:
# ANTHROPIC_WORKSPACE_ID=
# Optional proxy; local pharmacy calls bypass it (Node >=24.14).
# HTTPS_PROXY=http://127.0.0.1:7897
